{
  "expo": {
    "name": "moby_ops",
    "slug": "moby_ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/moby-app-icon.png",
    "scheme": "mobyops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es"
        ]
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.jersson04.mobyops",
      "icon": "./assets/brand/moby-app-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/moby-splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#D1FF00",
          "dark": {
            "backgroundColor": "#D1FF00",
            "image": "./assets/brand/moby-splash-logo.png"
          },
          "android": {
            "image": "./assets/brand/moby-splash-logo.png",
            "backgroundColor": "#D1FF00",
            "resizeMode": "contain",
            "imageWidth": 180,
            "dark": {
              "image": "./assets/brand/moby-splash-logo.png",
              "backgroundColor": "#D1FF00"
            }
          },
          "ios": {
            "image": "./assets/brand/moby-splash-logo.png",
            "backgroundColor": "#D1FF00",
            "resizeMode": "contain",
            "imageWidth": 240,
            "dark": {
              "image": "./assets/brand/moby-splash-logo.png",
              "backgroundColor": "#D1FF00"
            }
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es"
            ],
            "android": [
              "en",
              "es"
            ]
          }
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MOBY Ops to take evidence photos and scan bicycle codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MOBY Ops to record the location of your Public Order action.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b404e1b1-ed28-4f07-a703-5f3d98cce1da"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b404e1b1-ed28-4f07-a703-5f3d98cce1da"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
